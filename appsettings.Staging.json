{
  "AllowedHosts": "",
  "Security": {
    "RequireHttps": true,
    "HttpsPort": 443
  },
  "Database": {
    "Encryption": {
      "RequireProtectedSensitiveColumns": true,
      "ProtectLegacyDataOnStartup": false,
      "RequireEncryptedVolume": true,
      "EncryptedVolumeAttested": false
    }
  },
  "OpenApi": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "ControlIDApi": {
    "RequireAllowedDeviceHosts": true,
    "RequireHttpsDeviceUrls": true,
    "AllowedDeviceHosts": []
  },
  "CallbackSecurity": {
    "RequireSharedKey": true,
    "RequireSignedRequests": true,
    "AllowLoopback": false
  },
  "Observability": {
    "Metrics": {
      "Enabled": true,
      "AllowAnonymous": false
    }
  }
}
